{
  "name": "newsletter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3880",
    "dev:db": "DATABASE_URL=postgres://postgres@127.0.0.1:5439/postgres?sslmode=disable next dev -p 3880",
    "db:dev": "pglite-server --db=.pglite --port=5439 --max-connections=10",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    
    "nyhetsbrev:keygen": "node scripts/nyhetsbrev/keygen.mjs",
    "nyhetsbrev:export": "node scripts/nyhetsbrev/export.mjs",
    "nyhetsbrev:remove": "node scripts/nyhetsbrev/remove.mjs",
    "flytt:import": "node scripts/flytt-import.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "^8.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
